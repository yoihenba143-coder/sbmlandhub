// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PropertyType {
  LAND
  HOUSE
  FIELD
  SHOP
  COMMERCIAL
  RESIDENTIAL
}

enum ListingType {
  SALE
  RENT
  PURCHASE
}

enum PropertyStatus {
  AVAILABLE
  PENDING
  SOLD
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  pincode   String?
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties  Property[]
  submissions PropertySubmission[]
  inquiries   Inquiry[]

  @@map("users")
}

model Property {
  id          Int            @id @default(autoincrement())
  title       String
  description String?        @db.Text
  location    String
  district    String?
  state       String?
  pincode     String?
  type        PropertyType
  listingType ListingType    @default(SALE)
  price       Float
  area        String
  areaUnit    String?        @default("sq.ft")
  image       String
  images      String[]       @default([])
  video       String?
  videos      String[]       @default([])
  featured    Boolean        @default(false)
  status      PropertyStatus @default(AVAILABLE)

  highlights        String[]       @default([])
  legalVerification String[]       @default([])

  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("properties")
}

model PropertySubmission {
  id           String         @id @default(cuid())
  title        String
  type         PropertyType
  listingType  ListingType    @default(SALE)
  price        Float
  area         String
  areaUnit     String         @default("sq.ft")
  location     String
  district     String?
  state        String?
  pincode      String?
  description  String?        @db.Text
  ownerName    String
  ownerPhone   String
  ownerEmail   String?
  status       PropertyStatus @default(PENDING)

  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("property_submissions")
}

model Inquiry {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  enquiryType  String
  propertyType PropertyType?
  message      String        @db.Text
  isRead       Boolean       @default(false)

  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())

  @@map("inquiries")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

